{
  "name": "dsh-desktop-tools",
  "version": "0.4.5",
  "type": "module",
  "license": "MIT",
  "description": "Desktop selection toolbar, floating assistant, screenshots, long screenshots and screen recording for DSH",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./remote": "./dist/remote.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "files": [
    "dist",
    "assets",
    "locale",
    "source",
    "build-assets.mjs",
    "build-client.mjs",
    "tsconfig.json",
    "tsdown.config.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build-assets.mjs && tsdown --config-loader native && node build-client.mjs",
    "test": "node --experimental-strip-types --test source/apps/desktop/src/desktop-tools-config.test.ts source/apps/desktop/src/koffi-platform.test.ts source/apps/desktop/src/capture-ui/stitch.test.ts source/apps/desktop/native-extension-runtime/helper-executable.test.ts",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/1997liuyh-boop/dsh-desktop-tools.git"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "darwin",
        "win32",
        "linux"
      ]
    },
    "compatibility": {
      "dsh": "0.2.2-rc.1",
      "dshReleases": {
        "0.2.2-rc.1": "experimental"
      }
    }
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.8",
    "pdfjs-dist": "6.3.289",
    "turndown": "7.2.4",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "@koromix/koffi-darwin-arm64": "3.1.1",
    "@koromix/koffi-darwin-x64": "3.1.1",
    "@koromix/koffi-win32-arm64": "3.1.1",
    "@koromix/koffi-win32-x64": "3.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-app-boot": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-api-gateway": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/dsh-permission-presets": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-api-remotes": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-shortcuts": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "dsh-vision-router": ">=3.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-app-boot": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-gateway": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-permission-presets": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-shortcuts": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "dsh-vision-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/turndown": "5.0.6",
    "gifenc": "1.0.3",
    "mermaid": "^11.12.0",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vite": "^6.4.3"
  }
}
